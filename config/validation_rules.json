{
  "version": "2.0",
  "descripcion": "Reglas de validación POST-MATCHING. Solo reglas que dependen del output de matching.",
  "fecha_creacion": "2026-01-14",
  "fecha_migracion": "2026-02-13",
  "_nota_migracion": "v2.0: 20 reglas NLP migradas a config/nlp_validation_rules.json (NLP gate pre-matching). Quedan solo V02, V10, V27 (matching) + V24/V28/V30/V31 custom en auto_validator.py",
  "operadores_disponibles": [
    "is_null", "is_empty", "is_not_null", "is_not_empty",
    "eq", "neq", "lt", "gt", "lte", "gte",
    "contains", "not_contains", "contains_any", "contains_all",
    "matches_regex", "in_list", "not_in_list"
  ],
  "reglas_validacion": [
    {
      "id": "V02_isco_nulo_score_bajo",
      "descripcion": "Sin ISCO y score bajo indica falla en matching",
      "condiciones": [
        {"campo": "isco_code", "operador": "is_null"},
        {"campo": "match_score", "operador": "lt", "valor": 0.5}
      ],
      "logica": "AND",
      "diagnostico": "error_matching",
      "severidad": "alto",
      "mensaje": "Sin match ESCO - revisar matching_rules_business.json"
    },
    {
      "id": "V10_match_score_muy_bajo",
      "descripcion": "Score de matching muy bajo indica posible error",
      "condiciones": [
        {"campo": "isco_code", "operador": "is_not_null"},
        {"campo": "match_score", "operador": "lt", "valor": 0.4}
      ],
      "logica": "AND",
      "diagnostico": "error_matching_confianza",
      "severidad": "bajo",
      "mensaje": "Match con baja confianza - no bloquea validación"
    },
    {
      "id": "V27_divergencia_dual",
      "descripcion": "Regla de negocio y semantico asignan ISCO distinto",
      "condiciones": [
        {"campo": "dual_coinciden", "operador": "eq", "valor": 0},
        {"campo": "score_semantico", "operador": "gt", "valor": 0.65}
      ],
      "logica": "AND",
      "diagnostico": "warning_divergencia_dual",
      "severidad": "warning",
      "mensaje": "Regla y semantico difieren con score > 0.65 - revisar regla"
    }
  ],
  "_nota_V24_V31": "V24, V28, V30 y V31 son reglas custom en auto_validator.py. Requieren lógica Python con múltiples campos JSON del matching output (skills_matched_essential, skills_oferta_json, score_semantico, etc.).",
  "severidades": {
    "critico": {"orden": 1, "auto_rechazar": true},
    "alto": {"orden": 2, "auto_rechazar": false},
    "medio": {"orden": 3, "auto_rechazar": false},
    "bajo": {"orden": 4, "auto_rechazar": false},
    "warning": {"orden": 5, "auto_rechazar": false},
    "info": {"orden": 6, "auto_rechazar": false}
  },
  "_nota_politica": "Errores bloqueantes impiden la transición automática a validado_claude. Solo V02 y V10 bloquean porque indican ISCO potencialmente incorrecto. El resto son imperfecciones de datos secundarios.",
  "politica_transicion": {
    "errores_bloqueantes": [
      "V02_isco_nulo_score_bajo",
      "V10_match_score_muy_bajo",
      "NV02_sector_no_canonico"
    ],
    "errores_no_bloqueantes": [
      "V03_skills_insuficientes",
      "V07_titulo_codigo_interno",
      "V08_area_funcional_nula",
      "V09_seniority_nulo",
      "V11_tareas_vacias",
      "V12_provincia_vacia",
      "V14_descripcion_muy_corta",
      "V16_clae_missing",
      "V18_sector_igual_area",
      "V20_sector_salud_no_sanitario",
      "V22_empresa_confidencial_con_sector",
      "V24_skills_baja_coherencia",
      "V25_tareas_vacias_con_skills",
      "V26_formato_tareas_incorrecto",
      "V27_divergencia_dual",
      "V28_sin_skills_esenciales",
      "V29_tareas_muy_cortas",
      "V30_it_sin_skills_tecnicas",
      "V31_ocupacion_esco_incorrecta",
      "NQ01_seniority_titulo_senior_pero_junior",
      "NQ03_area_titulo_incoherente",
      "NQ05_modalidad_scraping_difiere",
      "NQ12_computrabajo_provincia_vacia",
      "NQ13_indeed_jornada_no_prefilled",
      "NQ16_sin_skills_desc_larga",
      "NV03_area_funcional_invalida",
      "NV08_sin_tareas_ni_skills",
      "NV_EXP_SENIORITY",
      "NV_CROSS_gente_seniority",
      "V27_skills_dual_divergencia",
      "V30_skills_it_sin_tecnicas"
    ]
  }
}
