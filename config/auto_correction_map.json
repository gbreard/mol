    },

    "warning_nlp_educacion_puesto": {
      "tipo_accion": "escalar_claude",
      "descripcion": "Educación no coherente con tipo de puesto operativo",
      "datos_para_claude": ["id_oferta", "titulo_limpio", "nivel_educativo"]
    },

    "warning_source_prefill_faltante": {
      "tipo_accion": "escalar_claude",
      "descripcion": "Portal con metadata estructurada pero prefill no aplicado",
      "datos_para_claude": ["id_oferta", "titulo_limpio", "portal", "postprocessor_cambios_count"]
    },

    "error_nlp_ubicacion_portal": {
