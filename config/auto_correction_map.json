      "datos_para_claude": ["id_oferta", "titulo_limpio", "sector_empresa", "clae_code", "clae_seccion"]
    },

    "warning_cross_gente_seniority": {
      "tipo_accion": "escalar_claude",
      "descripcion": "Gente a cargo + seniority trainee/junior - posible inconsistencia",
      "datos_para_claude": ["id_oferta", "titulo_limpio", "tiene_gente_cargo", "nivel_seniority"]
    },

    "error_scraping": {
      "tipo_accion": "escalar_claude",
      "descripcion": "Descripcion muy corta - posible scraping incompleto",
      "datos_para_claude": ["id_oferta", "titulo_limpio"]
    },

    "error_nlp_seniority_titulo": {
      "tipo_accion": "auto_corregir",
