      "logica": "AND",
      "diagnostico": "error_formato_tareas",
      "severidad": "medio",
      "mensaje": "Tareas separadas por comas - normalizar a punto y coma",
      "_migrado_de": "validation_rules.json"
    },
    {
      "id": "V29_tareas_muy_cortas",
      "grupo": "tareas",
      "descripcion": "Tareas extraidas pero extremadamente cortas",
