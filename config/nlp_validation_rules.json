    {
      "id": "NV11_sector_null_like",
      "descripcion": "Sector empresa es string null-like del LLM",
      "condiciones": [
        {"campo": "sector_empresa", "operador": "is_not_empty"},
        {
          "campo": "sector_empresa",
          "operador": "in_list",
          "valores": ["null", "None", "none", "NULL", "N/A", "n/a", "undefined", "sin dato", "Sin dato", "no especificado", "No especificado"]
        }
      ],
      "logica": "AND",
      "diagnostico": "error_nlp_null_like",
      "severidad": "alto",
      "mensaje": "Sector es string null-like del LLM - fix en postprocessor _normalize()"
