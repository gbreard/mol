    {
      "id": "NV04_seniority_invalido",
      "descripcion": "Nivel seniority no está en valores válidos conocidos",
      "condiciones": [
        {"campo": "nivel_seniority", "operador": "is_not_empty"},
        {
          "campo": "nivel_seniority",
          "operador": "not_in_list",
          "valores": ["trainee", "junior", "semi_senior", "semisenior", "senior", "lead", "manager", "director"]
