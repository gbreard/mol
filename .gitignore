# Exports Excel temporales
scripts/excel_exports/*.json
exports/*.xlsx
exports/*.csv
exports/validation/

# ChromaDB vectors (grandes)
database/esco_vectors/

# Metrics (pipeline runs, cola claude, NLP reports)
metrics/

