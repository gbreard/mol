data/tracking/*.bak*
*.bak_*
database/*.csv
database/*.txt
database/embeddings/

# Logs de sync del pipeline (autogenerados)
config/supabase_sync_log.json
config/vps_sync_log.json

# Archivos temporales de SQLite (autogenerados por el motor)
*.db-shm
*.db-wal

# Exports incrementales del VPS (autogenerados por cron de scraping)
data/vps_imports/

# Cache de equivalencias (autogenerado desde Supabase, TTL 24h)
config/skill_equivalences_lookup.json

# Dashboard R antiguo (repo separado, embebido por error)
Visual--/

# SPEC U-1 — snapshots BD/Supabase (rescatables, no van a git por tamaño)
data/snapshots/
# temp/ diagramas y revisiones locales
temp/

# === Limpieza pre-S1.A (2026-06-03) ===

# Dependencias Node (R4 — el cache de vitest se coló al índice)
node_modules/

# Datos derivados pesados y dumps regenerables (R1)
exports/tareas_canonizacion/
exports/sectores_2026-05-20/
exports/cyn_backlog/**/*.json
exports/cyn_backlog/**/*.jsonl
exports/cyn_backlog/**/*.xlsx
