.linear/

# Backups
backups/
_deprecated_LIMPIEZA_2025/
nul

# Datos de ofertas (no versionar)
01_sources/*/data/raw/*.json
01_sources/*/data/raw/*.csv
01_sources/*/data/raw/*.xlsx
01_sources/*/data/metrics/*.json
01_sources/*/data/archive/
